{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Wooolfmesh?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A private local-first command center for tasks, capture, focus, reviews, lessons, routines, analytics, search and optional AI."
      }
    },
    {
      "@type": "Question",
      "name": "Was Wooolfmesh previously called WorkOS Local?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Wooolfmesh began as WorkOS Local. The old name remains legacy/internal for compatibility."
      }
    },
    {
      "@type": "Question",
      "name": "Where does user data live?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Durable work memory lives in a user-owned Markdown vault. SQLite supports runtime state."
      }
    },
    {
      "@type": "Question",
      "name": "Is AI required?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. AI can help, but the app works without it."
      }
    },
    {
      "@type": "Question",
      "name": "Is Wooolfmesh Store-ready?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Store submission is blocked until package, screenshots, public URLs and Windows lifecycle validation are complete."
      }
    },
    {
      "@type": "Question",
      "name": "What are cognitive bites?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Compact reusable lessons, decisions, playbooks, mistakes and patterns captured from work history."
      }
    },
    {
      "@type": "Question",
      "name": "Does this site publish private vault data?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Public screenshots and demo data must be fictional or isolated."
      }
    }
  ]
}
