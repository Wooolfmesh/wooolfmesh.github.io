{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Wooolfmesh?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Wooolfmesh is local-first memory for agentic work: a private command center that turns Markdown-owned work memory into daily execution."
      }
    },
    {
      "@type": "Question",
      "name": "Was Wooolfmesh previously called WorkOS Local?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. WorkOS Local remains the compatibility name for package names, paths, environment variables, and the `_WorkOS` vault layout."
      }
    },
    {
      "@type": "Question",
      "name": "Where does data live?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Durable user-owned entities live as Markdown under the configured `_WorkOS` vault. SQLite stores runtime support such as reminders, events, indexes, registry data, and analytics."
      }
    },
    {
      "@type": "Question",
      "name": "Is AI required?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. AI is optional. Ollama/local AI and configured hosted providers can assist, but normal workflows remain usable without a model."
      }
    },
    {
      "@type": "Question",
      "name": "Can Wooolfmesh write into my other notes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The control vault is writable for Wooolfmesh-owned entities. Registered reference vaults are read-only by default and should not be silently mutated."
      }
    },
    {
      "@type": "Question",
      "name": "Where should I report bugs or product ideas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Open a public issue at https://github.com/Wooolfmesh/wooolfmesh.github.io/issues."
      }
    },
    {
      "@type": "Question",
      "name": "Is Wooolfmesh ready for Microsoft Store distribution?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Packaging, package validation, final Store screenshots, Windows lifecycle validation, and policy review are still incomplete."
      }
    }
  ]
}
