{
  "@context": "https://schema.org",
  "@type": "DataCatalog",
  "@id": "https://wooolfmesh.github.io/data/#catalog",
  "name": "Wooolfmesh public machine-readable data",
  "description": "Public JSON files that describe Wooolfmesh product entities, features, roadmap, FAQ, glossary and entity graph. No private vault data is included.",
  "url": "https://wooolfmesh.github.io/ai/",
  "dataset": [
    {
      "@type": "Dataset",
      "name": "Product data",
      "url": "https://wooolfmesh.github.io/data/product.json",
      "license": "https://github.com/wooolfmesh/wooolfmesh.github.io"
    },
    {
      "@type": "Dataset",
      "name": "Features data",
      "url": "https://wooolfmesh.github.io/data/features.json",
      "license": "https://github.com/wooolfmesh/wooolfmesh.github.io"
    },
    {
      "@type": "Dataset",
      "name": "Roadmap data",
      "url": "https://wooolfmesh.github.io/data/roadmap.json",
      "license": "https://github.com/wooolfmesh/wooolfmesh.github.io"
    },
    {
      "@type": "Dataset",
      "name": "Glossary data",
      "url": "https://wooolfmesh.github.io/data/glossary.json",
      "license": "https://github.com/wooolfmesh/wooolfmesh.github.io"
    },
    {
      "@type": "Dataset",
      "name": "FAQ data",
      "url": "https://wooolfmesh.github.io/data/faq.json",
      "license": "https://github.com/wooolfmesh/wooolfmesh.github.io"
    },
    {
      "@type": "Dataset",
      "name": "Entities data",
      "url": "https://wooolfmesh.github.io/data/entities.json",
      "license": "https://github.com/wooolfmesh/wooolfmesh.github.io"
    }
  ]
}
