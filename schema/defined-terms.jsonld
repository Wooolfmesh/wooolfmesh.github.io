{
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "name": "Wooolfmesh glossary",
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "name": "Wooolfmesh",
      "description": "A private local-first command center and memory system for agentic work.",
      "url": "https://wooolfmesh.github.io/glossary/#wooolfmesh"
    },
    {
      "@type": "DefinedTerm",
      "name": "WorkOS Local",
      "description": "Legacy/internal name for Wooolfmesh.",
      "url": "https://wooolfmesh.github.io/glossary/#workos-local"
    },
    {
      "@type": "DefinedTerm",
      "name": "Markdown vault",
      "description": "A local `_WorkOS` folder that stores durable user-owned work memory.",
      "url": "https://wooolfmesh.github.io/glossary/#markdown-vault"
    },
    {
      "@type": "DefinedTerm",
      "name": "SQLite runtime support",
      "description": "Local database support for reminders, events, indexes, diagnostics and local analytics.",
      "url": "https://wooolfmesh.github.io/glossary/#sqlite-runtime-support"
    },
    {
      "@type": "DefinedTerm",
      "name": "Preview-first",
      "description": "Generated or extracted changes are shown before the user saves anything.",
      "url": "https://wooolfmesh.github.io/glossary/#preview-first"
    },
    {
      "@type": "DefinedTerm",
      "name": "No silent mutation",
      "description": "The app must not alter private work memory without explicit user action.",
      "url": "https://wooolfmesh.github.io/glossary/#no-silent-mutation"
    },
    {
      "@type": "DefinedTerm",
      "name": "Cognitive bite",
      "description": "A reusable lesson, decision, mistake, playbook, principle or pattern.",
      "url": "https://wooolfmesh.github.io/glossary/#cognitive-bite"
    },
    {
      "@type": "DefinedTerm",
      "name": "Optional AI provider",
      "description": "A local or hosted model provider that assists workflows but is not required.",
      "url": "https://wooolfmesh.github.io/glossary/#optional-ai-provider"
    }
  ]
}
