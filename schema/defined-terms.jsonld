{
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "name": "Wooolfmesh glossary",
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "name": "Wooolfmesh",
      "description": "Wooolfmesh is local-first memory for agentic work: a private command center that turns Markdown-owned work memory into daily execution.",
      "url": "https://wooolfmesh.github.io/glossary/#wooolfmesh"
    },
    {
      "@type": "DefinedTerm",
      "name": "WorkOS Local",
      "description": "Legacy/internal compatibility name for Wooolfmesh.",
      "url": "https://wooolfmesh.github.io/glossary/#workos-local"
    },
    {
      "@type": "DefinedTerm",
      "name": "Markdown vault",
      "description": "The local `_WorkOS` subtree where durable Wooolfmesh-owned entities are stored as Markdown.",
      "url": "https://wooolfmesh.github.io/glossary/#markdown-vault"
    },
    {
      "@type": "DefinedTerm",
      "name": "SQLite runtime support",
      "description": "Local database support for reminders, events, indexes, diagnostics, local analytics, and integration metadata.",
      "url": "https://wooolfmesh.github.io/glossary/#sqlite-runtime-support"
    },
    {
      "@type": "DefinedTerm",
      "name": "Preview-first",
      "description": "Generated, extracted, or imported changes are shown before the user saves or applies anything durable.",
      "url": "https://wooolfmesh.github.io/glossary/#preview-first"
    },
    {
      "@type": "DefinedTerm",
      "name": "No silent mutation",
      "description": "The product must not alter private work memory without explicit user action.",
      "url": "https://wooolfmesh.github.io/glossary/#no-silent-mutation"
    },
    {
      "@type": "DefinedTerm",
      "name": "Cognitive bite",
      "description": "A compact reusable lesson, decision, mistake, principle, playbook, or pattern.",
      "url": "https://wooolfmesh.github.io/glossary/#cognitive-bite"
    },
    {
      "@type": "DefinedTerm",
      "name": "Operating manual",
      "description": "A user-authored local rulebook for recurring preferences, principles, and work habits.",
      "url": "https://wooolfmesh.github.io/glossary/#operating-manual"
    },
    {
      "@type": "DefinedTerm",
      "name": "Read-only knowledge vault",
      "description": "A registered vault that Wooolfmesh may index for search but must not write to by default.",
      "url": "https://wooolfmesh.github.io/glossary/#read-only-knowledge-vault"
    }
  ]
}
